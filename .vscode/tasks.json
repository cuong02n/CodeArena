{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Build & Run active file",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/run.ps1",
        "-Source", "${file}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
