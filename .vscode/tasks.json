{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Build & Run active file",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/run.ps1",
        "-Source", "${file}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "New CP problem",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/newcp.ps1",
        "-Contest", "${input:contest}",
        "-Problem", "${input:problem}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install CP keybindings",
      "detail": "Merge .vscode/keybindings.json (Ctrl+F9 / Ctrl+F8) into your user keybindings",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/install-keybindings.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "contest",
      "type": "promptString",
      "description": "Contest id (vd: 2243)"
    },
    {
      "id": "problem",
      "type": "promptString",
      "description": "Problem (vd: A)"
    }
  ]
}
